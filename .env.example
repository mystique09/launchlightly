# PostgreSQL (docker compose) — override the host port if 5438 is taken
POSTGRES_PORT=5438

# Database connection used by the server, migrate, and seed binaries
DATABASE_URL=postgres://postgres:secret@127.0.0.1:5438/launchlightly_db

# Bootstrap super admin created by `just db-seed`
LAUNCHLIGHTLY_SUPER_ADMIN_EMAIL=owner@launchlightly.local
LAUNCHLIGHTLY_SUPER_ADMIN_PASSWORD=change-me-before-seeding
# LAUNCHLIGHTLY_SUPER_ADMIN_NAME=Super Admin

# Better Auth — secret must be at least 32 characters; url is the public base URL
BETTER_AUTH_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
